;;; =====================================================================
;;;  FASAD.LSP — фасадные кассеты-пирамиды из листового металла
;;;
;;;  Загрузка:  APPLOAD (ЗАГПРИЛ) -> fasad.lsp -> Загрузить
;;;  Запуск:    ФАСАД  (или FASAD)
;;;
;;;  Каждый модуль — закрытая пирамида из ОДНОЙ детали: грани веером вокруг
;;;  вершины + отбортовка по краю (загиб назад, крепление к подсистеме).
;;;  Один шов от вершины к углу — сварка/заклёпки.
;;;
;;;  Плагин спрашивает размеры стены, форму модуля, глубину пирамиды, смещение
;;;  вершины (волна/случайно/шахматка), перфорацию, петельки на гибах и чертит:
;;;   * 3D-модель фасада (3D-грани) с номерами деталей — схема сборки;
;;;   * развёртки всех деталей, разложенные по листам (слой REZ — всё режется,
;;;     слой GIB — линии гиба для гибочного станка, слой NOMER — гравировка номера).
;;;
;;;  Работает в полном AutoCAD и в AutoCAD LT 2024+ (без ActiveX).
;;;  Файл в UTF-8 — для AutoCAD 2021 и новее; для 2020 и старше — fasad_cp1251.lsp
;;; =====================================================================

;;; ---------------------------------------------------------------- математика
(defun fs:v+ (a b) (mapcar '+ a b))
(defun fs:v- (a b) (mapcar '- a b))
(defun fs:v* (a k) (mapcar '(lambda (x) (* x k)) a))
(defun fs:dot (a b) (apply '+ (mapcar '* a b)))
(defun fs:len (a) (sqrt (fs:dot a a)))
(defun fs:unit (a) (fs:v* a (/ 1.0 (fs:len a))))
(defun fs:acos (x)
  (setq x (max -1.0 (min 1.0 x)))
  (atan (sqrt (- 1.0 (* x x))) x)
)
(defun fs:cross (a b)
  (list (- (* (cadr a) (caddr b)) (* (caddr a) (cadr b)))
        (- (* (caddr a) (car b)) (* (car a) (caddr b)))
        (- (* (car a) (cadr b)) (* (cadr a) (car b))))
)
(defun fs:ang (u v) (fs:acos (/ (fs:dot u v) (* (fs:len u) (fs:len v)))))
(defun fs:p3 (p) (list (float (car p)) (float (cadr p)) (if (caddr p) (float (caddr p)) 0.0)))
(defun fs:center (pts) (fs:v* (apply 'mapcar (cons '+ pts)) (/ 1.0 (length pts))))
(defun fs:move (pts d) (mapcar '(lambda (p) (fs:v+ p d)) pts))
(defun fs:rot (p a) (list (- (* (car p) (cos a)) (* (cadr p) (sin a)))
                          (+ (* (car p) (sin a)) (* (cadr p) (cos a)))))
(defun fs:dist-line (c a b)
  (/ (abs (- (* (- (car b) (car a)) (- (cadr c) (cadr a)))
             (* (- (cadr b) (cadr a)) (- (car c) (car a)))))
     (distance a b))
)
(defun fs:inradius (poly / c n i r)
  (setq c (fs:center poly) n (length poly) i 0 r 1e30)
  (while (< i n)
    (setq r (min r (fs:dist-line c (nth i poly) (nth (rem (1+ i) n) poly))) i (1+ i))
  )
  r
)
(defun fs:shrink (poly strip / c r k)
  (setq c (fs:center poly) r (fs:inradius poly) k (/ (- r (/ strip 2.0)) r))
  (if (> k 0.3) (mapcar '(lambda (p) (fs:v+ c (fs:v* (fs:v- p c) k))) poly))
)
(defun fs:round (x q) (* q (fix (+ (/ x q) (if (< x 0) -0.5 0.5)))))

;;; ---------------------------------------------------------------- ввод
(defun fs:num (msg def / v)
  (initget 6)
  (setq v (getreal (strcat "\n" msg " <" (rtos def 2 1) ">: ")))
  (if v (float v) def)
)
(defun fs:int (msg def bits lo hi / v ok)
  (while (not ok)
    (initget bits)
    (setq v (getint (strcat "\n" msg " <" (itoa def) ">: ")))
    (if (null v) (setq v def))
    (if (and (>= v lo) (<= v hi))
      (setq ok T)
      (princ (strcat "\nВведите число от " (itoa lo) " до " (itoa hi)))
    )
  )
  v
)

;;; ---------------------------------------------------------------- рисование
(defun fs:layer (nm col)
  (if (not (tblsearch "LAYER" nm))
    (entmake (list '(0 . "LAYER") '(100 . "AcDbSymbolTableRecord") '(100 . "AcDbLayerTableRecord")
                   (cons 2 nm) '(70 . 0) (cons 62 col) '(6 . "Continuous")))
  )
)
(defun fs:line (p q lay) (entmake (list '(0 . "LINE") (cons 8 lay) (cons 10 (fs:p3 p)) (cons 11 (fs:p3 q)))))
(defun fs:circle (c r lay) (entmake (list '(0 . "CIRCLE") (cons 8 lay) (cons 10 (fs:p3 c)) (cons 40 r))))
(defun fs:text (p hgt s lay)
  (entmake (list '(0 . "TEXT") (cons 8 lay) (cons 10 (fs:p3 p)) (cons 40 hgt) (cons 1 s)))
)
(defun fs:face (p1 p2 p3 p4 lay)
  (entmake (list '(0 . "3DFACE") (cons 8 lay) (cons 10 (fs:p3 p1)) (cons 11 (fs:p3 p2))
                 (cons 12 (fs:p3 p3)) (cons 13 (fs:p3 p4))))
)
(defun fs:rect (x0 y0 dx dy lay)
  (fs:line (list x0 y0) (list (+ x0 dx) y0) lay)
  (fs:line (list (+ x0 dx) y0) (list (+ x0 dx) (+ y0 dy)) lay)
  (fs:line (list (+ x0 dx) (+ y0 dy)) (list x0 (+ y0 dy)) lay)
  (fs:line (list x0 (+ y0 dy)) (list x0 y0) lay)
)
;; пунктир-прорез по линии гиба: прорез dsh, петелька br, на концах br без реза
(defun fs:dashes (a b dsh br lay / ln u uu k dl t0)
  (setq ln (distance a b))
  (setq u (fs:v* (fs:v- b a) (/ 1.0 ln)) uu (- ln (* 2.0 br)))
  (if (> uu 1.0)
    (progn
      (setq k (max 1 (fix (+ 0.5 (/ (+ uu br) (+ dsh br))))))
      (setq dl (/ (- uu (* (1- k) br)) k) t0 br)
      (repeat k
        (fs:line (fs:v+ a (fs:v* u t0)) (fs:v+ a (fs:v* u (+ t0 dl))) lay)
        (setq t0 (+ t0 dl br))
      )
    )
  )
)

;;; ---------------------------------------------------------------- раскладка модулей
(defun fs:rh (cx cy p q) (list (list cx (- cy q)) (list (+ cx p) cy) (list cx (+ cy q)) (list (- cx p) cy)))
(defun fs:quad (x y w h) (list (list x y) (list (+ x w) y) (list (+ x w) (+ y h)) (list x (+ y h))))
;; плитки с шагом (модуль + шов), с запасом за краями
(defun fs:tiles (shape ww hh pa / res i j a b hx dx dy r k poly lx y)
  (cond
    ((= shape 1)                                           ; квадрат
     (setq j 0)
     (while (<= j (fix (/ hh pa)))
       (setq i 0)
       (while (<= i (fix (/ ww pa)))
         (setq res (cons (fs:quad (* i pa) (* j pa) pa pa) res) i (1+ i)))
       (setq j (1+ j))))
    ((= shape 2)                                           ; треугольник
     (setq hx (* pa (/ (sqrt 3.0) 2.0)) j 0)
     (while (<= j (fix (/ hh hx)))
       (setq i -1 y (* j hx))
       (while (<= i (fix (/ (* 2.0 ww) pa)))
         (setq lx (* i (/ pa 2.0)))
         (if (= (rem (+ i j 100) 2) 0)
           (setq res (cons (list (list lx y) (list (+ lx pa) y) (list (+ lx (/ pa 2.0)) (+ y hx))) res))
           (setq res (cons (list (list lx (+ y hx)) (list (+ lx (/ pa 2.0)) y) (list (+ lx pa) (+ y hx))) res)))
         (setq i (1+ i)))
       (setq j (1+ j))))
    ((or (= shape 3) (= shape 6))                          ; ромб / вытянутый ромб
     (setq a pa b (* pa (if (= shape 3) 1.25 2.0)) j -1)
     (while (<= j (1+ (fix (/ hh b))))
       (setq i -1)
       (while (<= i (1+ (fix (/ ww a))))
         (setq res (cons (fs:rh (* (+ i 0.5) a) (* (+ j 0.5) b) (/ a 2.0) (/ b 2.0)) res))
         (setq res (cons (fs:rh (* i a) (* j b) (/ a 2.0) (/ b 2.0)) res))
         (setq i (1+ i)))
       (setq j (1+ j))))
    ((= shape 4)                                           ; шестигранник
     (setq r (/ pa 2.0) dx (* 1.5 r) dy (* (sqrt 3.0) r) i 0)
     (while (<= i (1+ (fix (/ ww dx))))
       (setq j 0)
       (while (<= j (1+ (fix (/ hh dy))))
         (setq poly nil k 5)
         (while (>= k 0)
           (setq poly (cons (list (+ (* i dx) (* r (cos (* k (/ pi 3.0)))))
                                  (+ (* j dy) (if (= (rem i 2) 1) (/ dy 2.0) 0.0) (* r (sin (* k (/ pi 3.0))))))
                            poly) k (1- k)))
         (setq res (cons poly res) j (1+ j)))
       (setq i (1+ i))))
    (T                                                     ; прямоугольник 1:2
     (setq j 0)
     (while (<= j (fix (/ hh (* 2.0 pa))))
       (setq i 0)
       (while (<= i (fix (/ ww pa)))
         (setq res (cons (fs:quad (* i pa) (* j 2.0 pa) pa (* 2.0 pa)) res) i (1+ i)))
       (setq j (1+ j))))
  )
  res
)
;; модули внутри стены, по центру; каждый = (основание вершина_xy знак_глубины)
(defun fs:layout (shape ww hh msz joint omode ofs dmode / tiles mods c minx miny maxx maxy dx dy
                    r amp ox oy s par sgn seed lam)
  (foreach tl (fs:tiles shape ww hh (+ msz joint))
    (setq c (fs:shrink tl joint))
    (if (and c (vl-every '(lambda (p) (and (>= (car p) -1e-6) (<= (car p) (+ ww 1e-6))
                                           (>= (cadr p) -1e-6) (<= (cadr p) (+ hh 1e-6)))) c))
      (setq mods (cons c mods)))
  )
  (if mods
    (progn
      (setq minx 1e30 miny 1e30 maxx -1e30 maxy -1e30)
      (foreach m mods (foreach p m (setq minx (min minx (car p)) maxx (max maxx (car p))
                                         miny (min miny (cadr p)) maxy (max maxy (cadr p)))))
      (setq dx (- (/ (- ww (- maxx minx)) 2.0) minx) dy (- (/ (- hh (- maxy miny)) 2.0) miny))
      (setq mods (mapcar '(lambda (m) (fs:move m (list dx dy))) mods))
      ;; вершины
      (setq seed 12345.0 lam (* 6.0 msz))
      (mapcar
        '(lambda (m)
           (setq c (fs:center m) r (fs:inradius m) amp (* ofs r) ox 0.0 oy 0.0)
           (setq par (rem (+ (fix (/ (+ (car c) 1e5) (+ msz joint))) (fix (/ (+ (cadr c) 1e5) (+ msz joint)))) 2))
           (cond
             ((= omode 2) (setq ox (* amp (sin (/ (* 2.0 pi (car c)) lam)))))
             ((= omode 3) (setq s (sin (/ (* 2.0 pi (+ (car c) (cadr c))) lam)) ox (* 0.7 amp s) oy (* 0.7 amp s)))
             ((= omode 4)
              (setq seed (rem (+ (* seed 9301.0) 49297.0) 233280.0) ox (* amp (- (* 2.0 (/ seed 233280.0)) 1.0)))
              (setq seed (rem (+ (* seed 9301.0) 49297.0) 233280.0) oy (* amp (- (* 2.0 (/ seed 233280.0)) 1.0))))
             ((= omode 5) (setq ox (* 0.7 amp (if (= par 0) 1.0 -1.0)) oy (* 0.7 amp (if (= par 0) 1.0 -1.0))))
             ((= shape 5) (setq ox (* -0.4 r) oy (* 0.5 r)))          ; прямоугольник: вершина смещена (как на фото 2)
           )
           ;; округление смещения — меньше разных деталей
           (if (> amp 1.0) (setq ox (fs:round ox (/ amp 2.0)) oy (fs:round oy (/ amp 2.0))))
           (setq sgn (cond ((= dmode 2) -1.0) ((= dmode 3) (if (= par 0) 1.0 -1.0)) (T 1.0)))
           (list m (fs:v+ c (list ox oy)) sgn))
        mods)
    )
  )
)

;;; ---------------------------------------------------------------- развёртка модуля
;; base — основание (CCW), apex — вершина (x y), dep — глубина (со знаком)
;; Возврат: (контур линии_гиба отверстия точка_подписи углы)
;; паз-ключ (замочная скважина): широкое отверстие R + узкий паз ширины 2a длиной ls вверх (v)
(defun fs:keyhole (c v rr a ls / th0 as pts k ang e)
  (setq th0 (atan (cadr v) (car v)) as (atan a (sqrt (- (* rr rr) (* a a)))) k 0)
  (while (<= k 16)
    (setq ang (+ th0 as (* k (/ (- (* 2.0 pi) (* 2.0 as)) 16.0))))
    (setq pts (cons (fs:v+ c (list (* rr (cos ang)) (* rr (sin ang)))) pts) k (1+ k)))
  (setq e (fs:v+ c (fs:v* v ls)) k 0)
  (while (<= k 8)
    (setq ang (+ th0 (/ pi -2.0) (* k (/ pi 8.0))))
    (setq pts (cons (fs:v+ e (list (* a (cos ang)) (* a (sin ang)))) pts) k (1+ k)))
  (reverse pts)
)
;; hang: 1-пазы-ключи (надеть), 2-отверстия, 0-нет;  lock: 1-шов без сварки (нахлёст+ушко), 2-сварка
(defun fs:net (base apex dep fl rl perf pitch hd pm hang lock / n st b a3 b3 angs gap th rays i ln L0 x y u nr
                 out bends holes nrm fn k dih flb cx cy pts row xs ys tri m lab bk d3 upk kh ear e nt w s0 s1 tt)
  (setq n (length base) st 0 i 1)
  (while (< i n)                                            ; шов — к самой нижней вершине
    (if (< (cadr (nth i base)) (- (cadr (nth st base)) 1e-6)) (setq st i))
    (setq i (1+ i))
  )
  (setq b nil i 0)
  (while (< i n) (setq b (append b (list (nth (rem (+ st i) n) base))) i (1+ i)))
  (setq a3 (list (car apex) (cadr apex) dep)
        b3 (mapcar '(lambda (p) (list (car p) (cadr p) 0.0)) b))
  (setq angs nil i 0)
  (while (< i n)
    (setq angs (append angs (list (fs:ang (fs:v- (nth i b3) a3) (fs:v- (nth (rem (1+ i) n) b3) a3)))) i (1+ i))
  )
  (setq gap (- (* 2.0 pi) (apply '+ angs)) th (+ (/ pi -2.0) (/ gap 2.0)) rays nil i 0)
  (while (<= i n)
    (setq L0 (fs:len (fs:v- (nth (rem i n) b3) a3)))
    (setq rays (append rays (list (list (* L0 (cos th)) (* L0 (sin th))))))
    (if (< i n) (setq th (+ th (nth i angs))))
    (setq i (1+ i))
  )
  ;; нормали граней (наружу) — для углов гиба
  (setq fn nil i 0)
  (while (< i n)
    (setq nrm (fs:unit (fs:cross (fs:v- (nth i b3) a3) (fs:v- (nth (rem (1+ i) n) b3) a3))))
    (if (< (* (caddr nrm) dep) 0) (setq nrm (fs:v* nrm -1.0)))
    (setq fn (append fn (list nrm)) i (1+ i))
  )
  (setq ear 30.0
        ear (if (and (= lock 1) (> (* gap (fs:len (nth n rays))) (+ ear fl 15.0))) ear nil))
  (setq out (list '(0.0 0.0)) bends nil holes nil kh nil i 0)
  (while (< i n)
    (setq x (nth i rays) y (nth (1+ i) rays) ln (distance x y) u (fs:v* (fs:v- y x) (/ 1.0 ln)))
    (setq nr (list (cadr u) (- (car u))))
    (if (< (fs:dot nr (fs:v* (fs:v+ x y) 0.5)) 0) (setq nr (fs:v* nr -1.0)))
    (if (and ear (= i (1- n)))
      ;; последняя отбортовка с ушком: огибает угол шва и ложится на первую отбортовку
      (progn
        (setq out (append out (list x (fs:v+ x (fs:v* u rl)) (fs:v+ (fs:v+ x (fs:v* u rl)) (fs:v* nr fl))
                                    (fs:v+ y (fs:v* nr fl))
                                    (fs:v+ (fs:v+ y (fs:v* u ear)) (fs:v* nr (- fl 4.0)))
                                    (fs:v+ (fs:v+ y (fs:v* u ear)) (fs:v* nr 4.0))
                                    (fs:v+ (fs:v+ y (fs:v* u 1.5)) (fs:v* nr 1.5)))))
        (setq bends (cons (list y (fs:v+ y (fs:v* nr fl))) bends))          ; гиб ушка
        (setq holes (cons (list (fs:v+ (fs:v+ y (fs:v* u (/ ear 2.0))) (fs:v* nr (/ fl 2.0))) 2.5) holes)))
      (setq out (append out (list x (fs:v+ x (fs:v* u rl)) (fs:v+ (fs:v+ x (fs:v* u rl)) (fs:v* nr fl))
                                  (fs:v+ (fs:v- y (fs:v* u rl)) (fs:v* nr fl)) (fs:v- y (fs:v* u rl)))))
    )
    ;; ответное отверстие под ушко в первой отбортовке
    (if (and ear (= i 0))
      (setq holes (cons (list (fs:v+ (fs:v+ x (fs:v* u (/ ear 2.0))) (fs:v* nr (/ fl 2.0))) 2.5) holes)))
    (setq bends (cons (list x y) bends))                    ; гиб грань-отбортовка
    (if (< i (1- n)) (setq bends (cons (list '(0.0 0.0) y) bends)))   ; гиб между гранями
    ;; крепление в отбортовке
    (setq d3 (fs:v- (nth (rem (1+ i) n) b3) (nth i b3)) upk (/ (cadr d3) (fs:len d3)))
    (cond
      ((and (= hang 1) (> (abs upk) 0.3))        ; боковая отбортовка: пазы-ключи, паз смотрит вверх
       (foreach tt (if (> ln 250.0) '(0.3 0.7) '(0.5))
         (setq kh (cons (fs:keyhole (fs:v+ (fs:v+ x (fs:v* u (* tt ln))) (fs:v* nr (/ fl 2.0)))
                                    (if (> upk 0) u (fs:v* u -1.0)) 4.5 2.75 12.0) kh))))
      ((= hang 2)
       (foreach tt (if (> ln 250.0) '(0.3 0.7) '(0.5))
         (setq holes (cons (list (fs:v+ (fs:v+ x (fs:v* u (* tt ln))) (fs:v* nr (/ fl 2.0))) 2.5) holes))))
    )
    ;; перфорация грани (O x y)
    (if (or (= perf 1) (and (= perf 2) (= (rem i 2) 0)))
      (progn
        (setq tri (list '(0.0 0.0) x y)
              xs (mapcar 'car tri) ys (mapcar 'cadr tri) row 0
              cy (+ (apply 'min ys) pm))
        (while (< cy (apply 'max ys))
          (setq cx (+ (apply 'min xs) pm (if (= (rem row 2) 1) (/ pitch 2.0) 0.0)))
          (while (< cx (apply 'max xs))
            (setq k 0 m T)
            (while (and m (< k 3))
              (if (< (/ (- (* (- (car (nth (rem (1+ k) 3) tri)) (car (nth k tri))) (- cy (cadr (nth k tri))))
                           (* (- (cadr (nth (rem (1+ k) 3) tri)) (cadr (nth k tri))) (- cx (car (nth k tri)))))
                        (distance (nth k tri) (nth (rem (1+ k) 3) tri)))
                     (+ pm (/ hd 2.0)))
                (setq m nil))
              (setq k (1+ k))
            )
            (if m (setq holes (cons (list (list cx cy) (/ hd 2.0)) holes)))
            (setq cx (+ cx pitch))
          )
          (setq cy (+ cy (* pitch 0.866)) row (1+ row))
        )
      )
    )
    (setq i (1+ i))
  )
  (setq out (append out (list (nth n rays))))
  ;; лапка внахлёст на шве (без сварки): заходит под первую грань
  (if (= lock 1)
    (progn
      (setq e (fs:unit (nth n rays)) nt (list (- (cadr e)) (car e)) w 15.0
            s0 (max (* 0.2 (fs:len (nth n rays))) (/ (* 1.8 w) (max 0.05 (fs:tan gap))))
            s1 (- (fs:len (nth n rays)) (if ear (+ fl 25.0) 25.0)))
      (if (> (- s1 s0) 40.0)
        (progn
          (setq out (append out (list (fs:v* e s1) (fs:v+ (fs:v* e (- s1 w)) (fs:v* nt w))
                                      (fs:v+ (fs:v* e (+ s0 w)) (fs:v* nt w)) (fs:v* e s0))))
          (setq bends (cons (list (fs:v* e s0) (fs:v* e s1)) bends))
        )
      )
    )
  )
  ;; углы гиба: между гранями и грань-отбортовка
  (setq dih nil i 0)
  (while (< i (1- n)) (setq dih (cons (* (/ 180.0 pi) (fs:ang (nth i fn) (nth (1+ i) fn))) dih) i (1+ i)))
  (setq flb nil i 0)
  (while (< i n)
    (setq bk (fs:unit (list (- (cadr (fs:v- (nth (rem (1+ i) n) b3) (nth i b3)))) (car (fs:v- (nth (rem (1+ i) n) b3) (nth i b3))) 0.0)))
    (setq flb (cons (* (/ 180.0 pi) (fs:ang (nth i fn) (fs:v* bk -1.0))) flb) i (1+ i))
  )
  (setq lab (fs:v* (fs:v+ (nth 1 rays) (nth 2 rays)) 0.33))
  (list out bends holes lab (list (apply 'min dih) (apply 'max dih) (apply 'min flb) (apply 'max flb)) kh)
)
(defun fs:tan (x) (/ (sin x) (cos x)))
;; повернуть деталь на угол a
(defun fs:net-rot (nt a)
  (list (mapcar '(lambda (p) (fs:rot p a)) (nth 0 nt))
        (mapcar '(lambda (l) (list (fs:rot (car l) a) (fs:rot (cadr l) a))) (nth 1 nt))
        (mapcar '(lambda (h) (list (fs:rot (car h) a) (cadr h))) (nth 2 nt))
        (fs:rot (nth 3 nt) a) (nth 4 nt)
        (mapcar '(lambda (k) (mapcar '(lambda (p) (fs:rot p a)) k)) (nth 5 nt)))
)
(defun fs:bbox (pts)
  (list (apply 'min (mapcar 'car pts)) (apply 'min (mapcar 'cadr pts))
        (apply 'max (mapcar 'car pts)) (apply 'max (mapcar 'cadr pts)))
)
;; поворот с минимальным габаритом, деталь от (0,0)
(defun fs:net-fit (nt / best a r bb ar)
  (setq a 0)
  (while (< a 180)
    (setq r (fs:net-rot nt (* a (/ pi 180.0))) bb (fs:bbox (car r))
          ar (* (- (nth 2 bb) (nth 0 bb)) (- (nth 3 bb) (nth 1 bb))))
    (if (or (null best) (< ar (car best))) (setq best (list ar r bb)))
    (setq a (+ a 5))
  )
  (setq r (cadr best) bb (caddr best))
  (list (fs:move (nth 0 r) (list (- (nth 0 bb)) (- (nth 1 bb))))
        (mapcar '(lambda (l) (fs:move l (list (- (nth 0 bb)) (- (nth 1 bb))))) (nth 1 r))
        (mapcar '(lambda (h) (list (fs:v- (car h) (list (nth 0 bb) (nth 1 bb))) (cadr h))) (nth 2 r))
        (fs:v- (nth 3 r) (list (nth 0 bb) (nth 1 bb)))
        (nth 4 r)
        (list (- (nth 2 bb) (nth 0 bb)) (- (nth 3 bb) (nth 1 bb)))
        (mapcar '(lambda (k) (fs:move k (list (- (nth 0 bb)) (- (nth 1 bb))))) (nth 5 r)))
)
;; начертить деталь в точке org
(defun fs:draw-part (nt org name bmode br dsh / o n i a b ln lim m u)
  (setq o (fs:move (nth 0 nt) org) n (length o) lim 0.0 i 0)
  (while (< i n) (setq lim (max lim (distance (nth i o) (nth (rem (1+ i) n) o))) i (1+ i)))
  (setq i 0)
  (while (< i n)                                       ; контур: перемычка на самой длинной стороне
    (setq a (nth i o) b (nth (rem (1+ i) n) o) ln (distance a b))
    (if (and (> br 0) (> ln (* 0.99 lim)))
      (progn
        (setq m (fs:v* (fs:v+ a b) 0.5) u (fs:v* (fs:v- b a) (/ 1.0 ln)))
        (fs:line a (fs:v- m (fs:v* u (/ br 2.0))) "REZ")
        (fs:line (fs:v+ m (fs:v* u (/ br 2.0))) b "REZ"))
      (if (> ln 0.01) (fs:line a b "REZ")))
    (setq i (1+ i))
  )
  (foreach l (nth 1 nt)                                ; линии гиба
    (if (= bmode 1)
      (fs:dashes (fs:v+ (car l) org) (fs:v+ (cadr l) org) dsh br "REZ")
      (fs:line (fs:v+ (car l) org) (fs:v+ (cadr l) org) "GIB"))
  )
  (foreach h (nth 2 nt) (fs:circle (fs:v+ (car h) org) (cadr h) "REZ"))
  (foreach k (nth 6 nt)                                ; пазы-ключи
    (setq k (fs:move k org) n (length k) i 0)
    (while (< i n) (fs:line (nth i k) (nth (rem (1+ i) n) k) "REZ") (setq i (1+ i))))
  (fs:text (fs:v+ (nth 3 nt) org) 25.0 name "NOMER")
)

;;; ---------------------------------------------------------------- команда
(setq *fs-names* '("Квадрат" "Треугольник" "Ромб" "Шестигранник" "Прямоугольник (вершина смещена)" "Ромб вытянутый"))
(setq *fs-omodes* '("по центру" "волна" "волна по диагонали" "случайно" "шахматка"))

(defun fs:main (/ ww hh th shape msz dep joint omode ofs dmode fl perf pitch hd pm hang lock bmode br dsh
                  sw sl mods types key nt tp idx parts cnt x y rowh sx sy sheet k p name n m b a3 sgn
                  base apex oldecho dflt info)
  (princ "\n=== ФАСАД: кассеты-пирамиды из листа ===")
  (setq ww (fs:num "Ширина стены, мм" 6000.0)
        hh (fs:num "Высота стены, мм" 3000.0)
        th (fs:num "Толщина металла, мм" 1.5))
  (princ "\nФорма модуля:")
  (setq k 0)
  (foreach nm *fs-names* (setq k (1+ k)) (princ (strcat "  " (itoa k) "-" nm)))
  (setq shape (fs:int "Выберите форму [1-6]" 1 6 1 6))
  (setq msz (fs:num "Размер модуля (ширина), мм" (nth (1- shape) '(600.0 700.0 500.0 600.0 500.0 400.0)))
        dep (fs:num "Глубина пирамиды, мм" 150.0))
  (princ "\nВершина: 1-по центру 2-волна 3-волна по диагонали 4-случайно 5-шахматка")
  (setq omode (fs:int "Смещение вершины [1-5]" 1 6 1 5))
  (setq dmode (fs:int "Вершина: 1-наружу 2-внутрь 3-шахматка" 1 6 1 3))
  (setq perf (fs:int "Перфорация: 0-нет 1-все грани 2-через одну грань" 0 4 0 2))
  (if (> perf 0)
    (setq hd (fs:num "Диаметр отверстий перфорации, мм" 10.0)
          pitch (fs:num "Шаг перфорации, мм" 25.0))
    (setq hd 10.0 pitch 25.0)
  )
  (setq bmode (fs:int "Линии гиба: 1-пунктир с петельками (гнуть руками) 2-линия на слое GIB (листогиб)" 1 6 1 2))
  (if (= bmode 1)
    (setq br  (fs:num "Петелька, мм" 2.0)
          dsh (fs:num "Прорез между петельками, мм" 10.0))
    (setq br (fs:num "Перемычка на контуре (держит деталь в листе), мм" 2.0) dsh 10.0)
  )
  (setq lock (fs:int "Шов модуля: 1-без сварки (лапка внахлёст + ушко на винт/заклёпку) 2-под сварку" 1 6 1 2))
  (setq hang (fs:int "Крепление: 1-навесное, пазы-ключи (просто надеть на винты/штифты) 2-отверстия 0-нет" 1 4 0 2))
  (setq dflt (fs:int "Остальные параметры по умолчанию? 1-да, 0-нет" 1 4 0 1))
  (setq joint 10.0 ofs 0.35 fl 30.0 pm 15.0 sw 1500.0 sl 3000.0)
  (if (= dflt 0)
    (setq joint (fs:num "Шов между модулями, мм" joint)
          ofs   (fs:num "Сила смещения вершины (0.1-0.6)" ofs)
          fl    (fs:num "Отбортовка назад, мм" fl)
          pm    (fs:num "Поле без перфорации у края грани, мм" pm)
          sw    (fs:num "Лист: ширина, мм" sw)
          sl    (fs:num "Лист: длина, мм" sl))
  )
  (setq oldecho (getvar "CMDECHO"))
  (setvar "CMDECHO" 0)
  (command "_.UNDO" "_BE")
  (fs:layer "REZ" 1) (fs:layer "GIB" 3) (fs:layer "NOMER" 5) (fs:layer "LIST" 8)
  (fs:layer "TEXT" 7) (fs:layer "FASAD_3D" 9) (fs:layer "SBORKA" 2)
  (princ "\nСчитаю модули...")
  (setq mods (fs:layout shape ww hh msz joint omode (min 0.6 ofs) dmode))
  (if (null mods)
    (princ "\nМодули не помещаются: уменьшите размер модуля.")
    (progn
      ;; --- типы деталей (одинаковая геометрия -> один номер)
      (setq types nil)
      (foreach md mods
        (setq base (car md) apex (cadr md) sgn (caddr md) p (fs:center base))
        (setq key (strcat (rtos (* sgn dep) 2 0) "|"
                          (apply 'strcat (mapcar '(lambda (q) (strcat (rtos (- (car q) (car apex)) 2 1) ","
                                                                      (rtos (- (cadr q) (cadr apex)) 2 1) ";")) base))))
        (if (setq tp (assoc key types))
          (setq types (subst (list key (cadr tp) (1+ (caddr tp)) (nth 3 tp)) tp types))
          (setq types (cons (list key (1+ (length types)) 1
                                  (fs:net-fit (fs:net base apex (* sgn dep) fl 1.0 perf pitch hd pm hang lock))) types)))
        (setq tp (assoc key types))
        ;; --- 3D модуль: грани и отбортовка (3D-грани)
        (setq a3 (list (car apex) (cadr apex) (* sgn dep)) n (length base) k 0)
        (while (< k n)
          (setq m (nth k base) b (nth (rem (1+ k) n) base))
          (fs:face a3 m b b "FASAD_3D")
          (fs:face (list (car m) (cadr m) 0.0) (list (car b) (cadr b) 0.0)
                   (list (car b) (cadr b) (- fl)) (list (car m) (cadr m) (- fl)) "FASAD_3D")
          (setq k (1+ k))
        )
        (fs:text (list (- (car p) 20.0) (- (cadr p) 10.0) (+ (abs dep) 5.0)) 40.0
                 (strcat "P" (itoa (cadr tp))) "SBORKA")
      )
      (setq types (reverse types))
      ;; --- раскладка деталей по листам (полосами)
      (setq parts nil)
      (foreach tp types (repeat (caddr tp) (setq parts (cons tp parts))))
      (setq parts (vl-sort parts '(lambda (a b) (> (cadr (nth 5 (nth 3 a))) (cadr (nth 5 (nth 3 b)))))))
      (setq sheet 0 x 1e30 y 0.0 rowh 0.0)
      (foreach tp parts
        (setq nt (nth 3 tp) m (nth 5 nt))
        (if (> (+ x (car m)) (- sw 10.0)) (setq x 10.0 y (+ y rowh 6.0) rowh 0.0))
        (if (or (= sheet 0) (> (+ y (cadr m)) (- sl 10.0)))
          (progn
            (setq sheet (1+ sheet) x 10.0 y 10.0 rowh 0.0)
            (setq sx (* (1- sheet) (+ sw 300.0)) sy (- (+ sl 800.0)))
            (fs:rect sx sy sw sl "LIST")
            (fs:text (list sx (+ sy sl 40.0)) 60.0
                     (strcat "ЛИСТ " (itoa sheet) "  " (rtos sw 2 0) "x" (rtos sl 2 0) "  t=" (rtos th 2 1)) "TEXT")))
        (if (or (> (car m) (- sw 20.0)) (> (cadr m) (- sl 20.0)))
          (princ (strcat "\nВНИМАНИЕ: деталь P" (itoa (cadr tp)) " больше листа — уменьшите модуль.")))
        (fs:draw-part nt (list (+ sx x) (+ sy y)) (strcat "P" (itoa (cadr tp))) bmode br dsh)
        (setq x (+ x (car m) 6.0) rowh (max rowh (cadr m)))
      )
      ;; --- таблица деталей
      (setq y (- (+ sl 800.0) 150.0))
      (fs:text (list 0.0 (- (+ sl 900.0))) 50.0 "ДЕТАЛИ:  номер — кол-во — углы гиба (между гранями / грань-отбортовка)" "TEXT")
      (setq k 0)
      (foreach tp types
        (setq info (nth 4 (nth 3 tp)) k (1+ k))
        (fs:text (list 0.0 (- (+ sl 900.0 (* k 70.0)))) 40.0
                 (strcat "P" (itoa (cadr tp)) " — " (itoa (caddr tp)) " шт — "
                         (rtos (nth 0 info) 2 0) "-" (rtos (nth 1 info) 2 0) " град / "
                         (rtos (nth 2 info) 2 0) "-" (rtos (nth 3 info) 2 0) " град")
                 "TEXT")
      )
      (fs:text (list 0.0 (+ hh 80.0)) 80.0
               (strcat "ФАСАД " (rtos ww 2 0) "x" (rtos hh 2 0) ", " (nth (1- shape) *fs-names*)
                       ", вершина " (nth (1- omode) *fs-omodes*) ", модулей " (itoa (length mods)))
               "TEXT")
      (princ (strcat "\nГотово. Модулей: " (itoa (length mods)) ", разных деталей: " (itoa (length types))
                     ", листов: " (itoa sheet) "."))
      (princ "\nСверху — 3D-фасад и номера деталей (слой SBORKA). Снизу — раскрой по листам и таблица.")
      (princ "\nДля лазера: слой REZ — резать; NOMER — гравировать; GIB — линии гиба; LIST/TEXT не выгружать.")
      (princ "\nСмотреть 3D: -ВИД -> ЮЗизо, стиль Концептуальный.")
      (command "_.ZOOM" "_E")
    )
  )
  (command "_.UNDO" "_E")
  (setvar "CMDECHO" oldecho)
  (princ)
)

(defun c:FASAD () (fs:main))
(defun c:ФАСАД () (fs:main))
(princ "\nFASAD.LSP загружен. Команда: ФАСАД (или FASAD).")
(princ)
