;;; =====================================================================
;;;  VOROTA.LSP — ворота из листового металла с узором из отгибных лепестков
;;;
;;;  Загрузка:  команда APPLOAD (ЗАГПРИЛ) -> выбрать vorota.lsp -> Загрузить
;;;  Запуск:    ВОРОТА  (или VOROTA)
;;;
;;;  Что делает:
;;;   * спрашивает ширину, высоту ворот, толщину металла и узор (9 вариантов);
;;;   * делит ворота на панели под размер листа (по умолчанию 1500x3000);
;;;   * чертит РАЗВЁРТКУ для лазера (слой REZ — всё режется):
;;;       - лучи от центра ячейки к углам — сквозной рез (лепестки);
;;;       - стороны ячейки — пунктир-прорез с перемычками (петельками) — линия гиба;
;;;       - контур панели с перемычками, чтобы панель держалась в листе;
;;;   * строит 3D-модель ворот: лист с толщиной, лепестки отогнуты на заданный
;;;     угол (изгибы), рама из профильной трубы.
;;;
;;;  Нужен полный AutoCAD (не LT): 3D-тела и ActiveX в LT недоступны.
;;;  Файл в UTF-8 — для AutoCAD 2021 и новее. Для 2020 и старше: vorota_cp1251.lsp
;;; =====================================================================

(vl-load-com)

;;; ---------------------------------------------------------------- векторы
(defun vr:v+ (a b) (mapcar '+ a b))
(defun vr:v- (a b) (mapcar '- a b))
(defun vr:v* (a k) (mapcar '(lambda (x) (* x k)) a))
(defun vr:tan (x) (/ (sin x) (cos x)))
(defun vr:p3 (p) (list (float (car p)) (float (cadr p)) 0.0))
(defun vr:center (pts)
  (vr:v* (apply 'mapcar (cons '+ pts)) (/ 1.0 (length pts)))
)
(defun vr:dist-line (c a b)
  (/ (abs (- (* (- (car b) (car a)) (- (cadr c) (cadr a)))
             (* (- (cadr b) (cadr a)) (- (car c) (car a)))))
     (distance a b))
)
(defun vr:move (poly d) (mapcar '(lambda (p) (vr:v+ p d)) poly))

;;; ---------------------------------------------------------------- ввод
(defun vr:num (msg def / v)
  (initget 6)
  (setq v (getreal (strcat "\n" msg " <" (rtos def 2 1) ">: ")))
  (if v (float v) def)
)
(defun vr:int (msg def bits lo hi / v ok)
  (while (not ok)
    (initget bits)
    (setq v (getint (strcat "\n" msg " <" (itoa def) ">: ")))
    (if (null v) (setq v def))
    (if (and (>= v lo) (<= v hi))
      (setq ok T)
      (princ (strcat "\nВведите число от " (itoa lo) " до " (itoa hi)))
    )
  )
  v
)

;;; ---------------------------------------------------------------- рисование
(defun vr:layer (nm col)
  (if (not (tblsearch "LAYER" nm))
    (entmake (list '(0 . "LAYER") '(100 . "AcDbSymbolTableRecord")
                   '(100 . "AcDbLayerTableRecord") (cons 2 nm) '(70 . 0)
                   (cons 62 col) '(6 . "Continuous")))
  )
)
(defun vr:line (p q lay)
  (entmake (list '(0 . "LINE") (cons 8 lay) (cons 10 (vr:p3 p)) (cons 11 (vr:p3 q))))
)
(defun vr:text (p hgt s lay)
  (entmake (list '(0 . "TEXT") (cons 8 lay) (cons 10 (vr:p3 p)) (cons 40 hgt) (cons 1 s)))
)
(defun vr:lwpoly (pts lay closed)
  (entmake
    (append
      (list '(0 . "LWPOLYLINE") '(100 . "AcDbEntity") (cons 8 lay)
            '(100 . "AcDbPolyline") (cons 90 (length pts)) (cons 70 (if closed 1 0)))
      (mapcar '(lambda (p) (list 10 (float (car p)) (float (cadr p)))) pts)
    )
  )
  (entlast)
)
(defun vr:rect (x0 y0 dx dy lay)
  (vr:lwpoly (list (list x0 y0) (list (+ x0 dx) y0) (list (+ x0 dx) (+ y0 dy)) (list x0 (+ y0 dy)))
             lay T)
)

;; пунктир-прорез по линии гиба: штрих dsh, перемычка br, на концах br без реза
(defun vr:dashes (a b dsh br lay / ln u uu k dl t0)
  (setq ln (distance a b))
  (setq u (vr:v* (vr:v- b a) (/ 1.0 ln)))
  (setq uu (- ln (* 2.0 br)))
  (if (> uu 1.0)
    (progn
      (setq k (max 1 (fix (+ 0.5 (/ (+ uu br) (+ dsh br))))))
      (setq dl (/ (- uu (* (1- k) br)) k) t0 br)
      (repeat k
        (vr:line (vr:v+ a (vr:v* u t0)) (vr:v+ a (vr:v* u (+ t0 dl))) lay)
        (setq t0 (+ t0 dl br))
      )
    )
  )
)

;;; ---------------------------------------------------------------- узоры
;; каждый генератор возвращает список многоугольников (CCW) с запасом за краями
(defun vr:rh (cx cy p q)
  (list (list cx (- cy q)) (list (+ cx p) cy) (list cx (+ cy q)) (list (- cx p) cy))
)
(defun vr:g-rhombs (rw rh a b / res i j p q nx ny)
  (setq p (/ a 2.0) q (/ b 2.0)
        nx (+ 2 (fix (/ rw a))) ny (+ 2 (fix (/ rh b))) j -1)
  (while (<= j ny)
    (setq i -1)
    (while (<= i nx)
      (setq res (cons (vr:rh (* (+ i 0.5) a) (* (+ j 0.5) b) p q) res))
      (setq res (cons (vr:rh (* i a) (* j b) p q) res))
      (setq i (1+ i))
    )
    (setq j (1+ j))
  )
  res
)
(defun vr:g-tris (rw rh sz / res hh i j lx y nx ny)
  (setq hh (* sz (/ (sqrt 3.0) 2.0))
        nx (+ 3 (fix (/ (* 2.0 rw) sz))) ny (+ 2 (fix (/ rh hh))) j -1)
  (while (<= j ny)
    (setq i -2 y (* j hh))
    (while (<= i nx)
      (setq lx (* i (/ sz 2.0)))
      (if (= (rem (+ i j 100) 2) 0)
        (setq res (cons (list (list lx y) (list (+ lx sz) y) (list (+ lx (/ sz 2.0)) (+ y hh))) res))
        (setq res (cons (list (list lx (+ y hh)) (list (+ lx (/ sz 2.0)) y) (list (+ lx sz) (+ y hh))) res))
      )
      (setq i (1+ i))
    )
    (setq j (1+ j))
  )
  res
)
(defun vr:g-squares (rw rh sz / res i j x y)
  (setq j -1)
  (while (<= j (+ 1 (fix (/ rh sz))))
    (setq i -1)
    (while (<= i (+ 1 (fix (/ rw sz))))
      (setq x (* i sz) y (* j sz))
      (setq res (cons (list (list x y) (list (+ x sz) y) (list (+ x sz) (+ y sz)) (list x (+ y sz))) res))
      (setq i (1+ i))
    )
    (setq j (1+ j))
  )
  res
)
(defun vr:g-hex (rw rh sz / res r dx dy i j cx cy k poly)
  (setq r (/ sz 2.0) dx (* 1.5 r) dy (* (sqrt 3.0) r) i -1)
  (while (<= i (+ 2 (fix (/ rw dx))))
    (setq j -1)
    (while (<= j (+ 2 (fix (/ rh dy))))
      (setq cx (* i dx) cy (+ (* j dy) (if (= (rem (+ i 100) 2) 1) (/ dy 2.0) 0.0)) poly nil k 5)
      (while (>= k 0)
        (setq poly (cons (list (+ cx (* r (cos (* k (/ pi 3.0))))) (+ cy (* r (sin (* k (/ pi 3.0)))))) poly))
        (setq k (1- k))
      )
      (setq res (cons poly res))
      (setq j (1+ j))
    )
    (setq i (1+ i))
  )
  res
)
(defun vr:g-oct (rw rh sz / res r d i j cx cy k poly)
  (setq r (/ (/ sz 2.0) (cos (/ pi 8.0)))
        d (/ (* sz (vr:tan (/ pi 8.0))) (sqrt 2.0)) i -1)
  (while (<= i (+ 1 (fix (/ rw sz))))
    (setq j -1)
    (while (<= j (+ 1 (fix (/ rh sz))))
      (setq cx (* (+ i 0.5) sz) cy (* (+ j 0.5) sz) poly nil k 7)
      (while (>= k 0)
        (setq poly (cons (list (+ cx (* r (cos (+ (/ pi 8.0) (* k (/ pi 4.0))))))
                               (+ cy (* r (sin (+ (/ pi 8.0) (* k (/ pi 4.0)))))))
                         poly))
        (setq k (1- k))
      )
      (setq res (cons poly res))
      (setq res (cons (vr:rh (* (1+ i) sz) (* (1+ j) sz) d d) res))
      (setq j (1+ j))
    )
    (setq i (1+ i))
  )
  res
)
(defun vr:g-herring (rw rh sz / res hh d i j x y)
  (setq hh (* 0.6 sz) d (* 0.5 sz) i -1)
  (while (<= i (+ 1 (fix (/ rw sz))))
    (setq j -2)
    (while (<= j (+ 2 (fix (/ rh hh))))
      (setq x (* i sz) y (* j hh))
      (if (= (rem (+ i 100) 2) 0)
        (setq res (cons (list (list x y) (list (+ x sz) (+ y d)) (list (+ x sz) (+ y d hh)) (list x (+ y hh))) res))
        (setq res (cons (list (list x (+ y d)) (list (+ x sz) y) (list (+ x sz) (+ y hh)) (list x (+ y d hh))) res))
      )
      (setq j (1+ j))
    )
    (setq i (1+ i))
  )
  res
)
(defun vr:g-bricks (rw rh sz / res hb i j x y)
  (setq hb (* 0.5 sz) j -1)
  (while (<= j (+ 1 (fix (/ rh hb))))
    (setq i -2)
    (while (<= i (+ 1 (fix (/ rw sz))))
      (setq x (+ (* i sz) (if (= (rem (+ j 100) 2) 1) (/ sz 2.0) 0.0)) y (* j hb))
      (setq res (cons (list (list x y) (list (+ x sz) y) (list (+ x sz) (+ y hb)) (list x (+ y hb))) res))
      (setq i (1+ i))
    )
    (setq j (1+ j))
  )
  res
)
(defun vr:g-crystal (rw rh sz / res)
  (foreach r (vr:g-rhombs rw rh sz (* 1.1 sz))
    ;; r = (S E N W) -> нижний (W S E) и верхний (W E N)
    (setq res (cons (list (nth 3 r) (nth 0 r) (nth 1 r)) res))
    (setq res (cons (list (nth 3 r) (nth 1 r) (nth 2 r)) res))
  )
  res
)

(setq *vr-names* '("Ромб" "Треугольник" "Квадрат" "Соты" "Восьмигранник"
                   "Ёлочка" "Кирпич" "Алмаз" "Кристалл"))

(defun vr:gen (pat rw rh sz)
  (cond
    ((= pat 1) (vr:g-rhombs rw rh sz (* 1.25 sz)))
    ((= pat 2) (vr:g-tris rw rh sz))
    ((= pat 3) (vr:g-squares rw rh sz))
    ((= pat 4) (vr:g-hex rw rh sz))
    ((= pat 5) (vr:g-oct rw rh sz))
    ((= pat 6) (vr:g-herring rw rh sz))
    ((= pat 7) (vr:g-bricks rw rh sz))
    ((= pat 8) (vr:g-rhombs rw rh sz (* 2.0 sz)))
    (T (vr:g-crystal rw rh sz))
  )
)

;; уменьшить ячейку, чтобы между соседями осталась полоса металла strip
(defun vr:shrink (poly strip / c rin n i k)
  (setq c (vr:center poly) n (length poly) rin 1e30 i 0)
  (while (< i n)
    (setq rin (min rin (vr:dist-line c (nth i poly) (nth (rem (1+ i) n) poly))))
    (setq i (1+ i))
  )
  (setq k (/ (- rin (/ strip 2.0)) rin))
  (if (> k 0.3)
    (mapcar '(lambda (p) (vr:v+ c (vr:v* (vr:v- p c) k))) poly)
  )
)
;; обрезка многоугольника полуплоскостью: idx 0=x 1=y; less=T оставляем <= val
(defun vr:clip-side (pts idx val less / out n i cur prv ic ip tt)
  (setq n (length pts) i 0)
  (while (< i n)
    (setq cur (nth i pts) prv (nth (if (= i 0) (1- n) (1- i)) pts))
    (setq ic (if less (<= (nth idx cur) (+ val 1e-9)) (>= (nth idx cur) (- val 1e-9)))
          ip (if less (<= (nth idx prv) (+ val 1e-9)) (>= (nth idx prv) (- val 1e-9))))
    (if (/= ic ip)
      (progn
        (setq tt (/ (- val (nth idx prv)) (- (nth idx cur) (nth idx prv))))
        (setq out (cons (vr:v+ prv (vr:v* (vr:v- cur prv) tt)) out))
      )
    )
    (if ic (setq out (cons cur out)))
    (setq i (1+ i))
  )
  (reverse out)
)
(defun vr:clip-rect (pts x0 y0 x1 y1 / res)
  (setq pts (vr:clip-side pts 0 x0 nil))
  (if pts (setq pts (vr:clip-side pts 0 x1 T)))
  (if pts (setq pts (vr:clip-side pts 1 y0 nil)))
  (if pts (setq pts (vr:clip-side pts 1 y1 T)))
  ;; убрать совпадающие точки
  (foreach p pts
    (if (or (null res) (> (distance p (car res)) 0.01)) (setq res (cons p res)))
  )
  (if (and res (> (length res) 1) (< (distance (car res) (last res)) 0.01)) (setq res (cdr res)))
  (reverse res)
)
(defun vr:area (pts / n i a b s)
  (setq n (length pts) i 0 s 0.0)
  (while (< i n)
    (setq a (nth i pts) b (nth (rem (1+ i) n) pts))
    (setq s (+ s (- (* (car a) (cadr b)) (* (cadr a) (car b)))))
    (setq i (1+ i))
  )
  (abs (/ s 2.0))
)
;; узор на всю площадь ворот (сквозной через стыки листов), уже с полосой strip
(defun vr:pattern (pat gw gh sz strip / res c)
  (foreach poly (vr:gen pat gw gh sz)
    (setq c (vr:shrink poly strip))
    (if c (setq res (cons c res)))
  )
  res
)
;; убрать слишком короткие стороны (после обрезки у края), чтобы не было узких лепестков
(defun vr:merge-short (pts mine / changed n i res)
  (setq changed T)
  (while (and changed (> (length pts) 3))
    (setq changed nil n (length pts) i 0 res nil)
    (while (< i n)
      (if (and (not changed) (< (distance (nth i pts) (nth (rem (1+ i) n) pts)) mine))
        (setq changed T)                       ; пропускаем вершину i
        (setq res (cons (nth i pts) res))
      )
      (setq i (1+ i))
    )
    (setq pts (reverse res))
  )
  pts
)
;; ячейки одной панели: обрезка узора по полю панели; координаты от угла панели.
;; Каждая ячейка = (центр . вершины): от центра режутся лучи к вершинам.
(defun vr:cells (pattern x0 y0 pw ph brd / res c a0 cen cc)
  (foreach poly pattern
    (setq a0 (vr:area poly) cen (vr:center poly))
    (setq c (vr:clip-rect poly (+ x0 brd) (+ y0 brd) (- (+ x0 pw) brd) (- (+ y0 ph) brd)))
    (if c (setq c (vr:merge-short c 20.0)))
    (if (and c (>= (length c) 3) (>= (vr:area c) (* 0.3 a0)))
      (progn
        ;; центр: исходный, если он внутри обрезанной ячейки с запасом 15 мм, иначе центр обрезка
        (setq cc (vr:center c))
        (if (and (> (car cen) (+ x0 brd 15.0)) (< (car cen) (- (+ x0 pw) brd 15.0))
                 (> (cadr cen) (+ y0 brd 15.0)) (< (cadr cen) (- (+ y0 ph) brd 15.0)))
          (setq cc cen)
        )
        (setq res (cons (cons (vr:v- cc (list x0 y0)) (vr:move c (list (- x0) (- y0)))) res))
      )
    )
  )
  res
)

;;; ---------------------------------------------------------------- развёртка
(defun vr:circle (c r lay)
  (entmake (list '(0 . "CIRCLE") (cons 8 lay) (cons 10 (vr:p3 c)) (cons 40 r)))
)
;; развёртка панели: лицевая часть pw x ph + отбортовка fl по периметру (гиб 90 назад)
(defun vr:flat (cells pw ph org br dsh fl bolt / o n i a b m u ln c k lim step cnt poly cell)
  (setq o (list (list 0.0 (- fl)) (list pw (- fl)) (list pw 0.0) (list (+ pw fl) 0.0)
                (list (+ pw fl) ph) (list pw ph) (list pw (+ ph fl)) (list 0.0 (+ ph fl))
                (list 0.0 ph) (list (- fl) ph) (list (- fl) 0.0) (list 0.0 0.0)))
  (setq o (vr:move o org) n (length o))
  ;; наружный контур: перемычки на 4 длинных сторонах (держат деталь в листе)
  (setq lim (* 0.5 (min pw ph)) i 0)
  (while (< i n)
    (setq a (nth i o) b (nth (rem (1+ i) n) o) ln (distance a b))
    (if (> ln lim)
      (progn
        (setq m (vr:v* (vr:v+ a b) 0.5) u (vr:v* (vr:v- b a) (/ 1.0 ln)))
        (vr:line a (vr:v- m (vr:v* u (/ br 2.0))) "REZ")
        (vr:line (vr:v+ m (vr:v* u (/ br 2.0))) b "REZ")
      )
      (vr:line a b "REZ")
    )
    (setq i (1+ i))
  )
  ;; линии гиба отбортовки
  (setq c (list org (vr:v+ org (list pw 0.0)) (vr:v+ org (list pw ph)) (vr:v+ org (list 0.0 ph))) i 0)
  (while (< i 4)
    (vr:dashes (nth i c) (nth (rem (1+ i) 4) c) dsh br "REZ")
    (setq i (1+ i))
  )
  ;; отверстия под болты М8 в отбортовке (соединение листов между собой и с рамой)
  (if (= bolt 1)
    (progn
      (foreach side (list (list (list 0.0 (- (/ fl 2.0))) (list pw (- (/ fl 2.0))))
                          (list (list 0.0 (+ ph (/ fl 2.0))) (list pw (+ ph (/ fl 2.0))))
                          (list (list (- (/ fl 2.0)) 0.0) (list (- (/ fl 2.0)) ph))
                          (list (list (+ pw (/ fl 2.0)) 0.0) (list (+ pw (/ fl 2.0)) ph)))
        (setq a (car side) b (cadr side) ln (distance a b))
        (setq cnt (max 2 (1+ (fix (+ 0.5 (/ (- ln 120.0) 300.0))))))
        (setq step (/ (- ln 120.0) (1- cnt)) k 0)
        (while (< k cnt)
          (vr:circle (vr:v+ org (vr:v+ a (vr:v* (vr:v- b a) (/ (+ 60.0 (* k step)) ln)))) 4.25 "REZ")
          (setq k (1+ k))
        )
      )
    )
  )
  ;; ячейки: лучи — сквозной рез, стороны — пунктир (гиб)
  (foreach cell cells
    (setq poly (vr:move (cdr cell) org) c (vr:v+ (car cell) org) n (length poly) k 0)
    (while (< k n)
      (vr:line c (nth k poly) "REZ")
      (vr:dashes (nth k poly) (nth (rem (1+ k) n) poly) dsh br "REZ")
      (setq k (1+ k))
    )
  )
)

;;; ---------------------------------------------------------------- 3D
(defun vr:region (pts / e arr)
  (setq e (vr:lwpoly pts "0" T))
  (setq arr (vlax-make-safearray vlax-vbObject '(0 . 0)))
  (vlax-safearray-put-element arr 0 (vlax-ename->vla-object e))
  (setq arr (vlax-safearray->list (vlax-variant-value (vla-AddRegion *vr-ms* arr))))
  (entdel e)
  (car arr)
)
(defun vr:extrude (pts th lay / reg sol)
  (setq reg (vr:region pts))
  (setq sol (vla-AddExtrudedSolid *vr-ms* reg th 0.0))
  (vla-delete reg)
  (vla-put-layer sol lay)
  sol
)
(defun vr:3d-panel (cells pw ph org th ang fl / plate hole poly c n k a b sol z rot x0 y0 cell)
  ;; лист с вырезами под ячейки
  (setq plate (vr:region (list org (vr:v+ org (list pw 0.0)) (vr:v+ org (list pw ph))
                               (vr:v+ org (list 0.0 ph)))))
  (foreach cell cells
    (setq hole (vr:region (vr:move (cdr cell) org)))
    (vla-Boolean plate 2 hole)                 ; 2 = вычитание
  )
  (setq sol (vla-AddExtrudedSolid *vr-ms* plate th 0.0))
  (vla-delete plate)
  (vla-put-layer sol "VOROTA_3D")
  ;; отбортовка: загнута назад на 90 градусов
  (setq x0 (car org) y0 (cadr org))
  (foreach bx (list (list x0 y0 (+ x0 pw) (+ y0 th))
                    (list x0 (- (+ y0 ph) th) (+ x0 pw) (+ y0 ph))
                    (list x0 y0 (+ x0 th) (+ y0 ph))
                    (list (- (+ x0 pw) th) y0 (+ x0 pw) (+ y0 ph)))
    (vla-put-layer (vr:box (nth 0 bx) (nth 1 bx) (nth 2 bx) (nth 3 bx) (- fl) 0.0) "VOROTA_3D")
  )
  ;; лепестки, отогнутые наружу по сторонам ячейки
  (foreach cell cells
    (setq poly (vr:move (cdr cell) org) c (vr:v+ (car cell) org) n (length poly) k 0)
    (while (< k n)
      (setq a (nth k poly) b (nth (rem (1+ k) n) poly))
      (setq sol (vr:extrude (list c a b) th "VOROTA_3D"))
      ;; знак поворота: вершина лепестка должна уйти вперёд (+Z)
      (setq z (- (* (- (car b) (car a)) (- (cadr c) (cadr a)))
                 (* (- (cadr b) (cadr a)) (- (car c) (car a)))))
      (setq rot (if (> z 0) ang (- ang)))
      (vla-Rotate3D sol (vlax-3d-point (vr:p3 a)) (vlax-3d-point (vr:p3 b)) rot)
      (setq k (1+ k))
    )
  )
)
(defun vr:box (x0 y0 x1 y1 z0 z1 / b)
  (setq b (vla-AddBox *vr-ms*
            (vlax-3d-point (list (/ (+ x0 x1) 2.0) (/ (+ y0 y1) 2.0) (/ (+ z0 z1) 2.0)))
            (abs (- x1 x0)) (abs (- y1 y0)) (abs (- z1 z0))))
  (vla-put-layer b "VOROTA_RAMA")
  b
)
(defun vr:frame (gw gh cols rows pw ph tw td z0 / i)
  ;; профильная труба tw (в плоскости ворот) x td (в глубину), за листом
  (vr:box 0.0 0.0 gw tw (- z0 td) z0)
  (vr:box 0.0 (- gh tw) gw gh (- z0 td) z0)
  (setq i 0)
  (while (<= i cols)
    (vr:box (max 0.0 (min (- gw tw) (- (* i pw) (/ tw 2.0)))) tw
            (max tw (min gw (+ (* i pw) (/ tw 2.0)))) (- gh tw) (- z0 td) z0)
    (setq i (1+ i))
  )
  (setq i 1)
  (while (< i rows)
    (vr:box tw (- (* i ph) (/ tw 2.0)) (- gw tw) (+ (* i ph) (/ tw 2.0)) (- z0 td) z0)
    (setq i (1+ i))
  )
)

;;; ---------------------------------------------------------------- команда
(defun vr:main (/ *error* doc gw gh th pat sz ang br dsh strip brd sw sl mk3d mkfr dflt
                  cols rows pw ph cells pattern fl bolt ci ri org n i mass oldecho)
  (setq doc (vla-get-ActiveDocument (vlax-get-acad-object))
        *vr-ms* (vla-get-ModelSpace doc))
  (defun *error* (msg)
    (if (and msg (not (wcmatch (strcase msg) "*CANCEL*,*QUIT*,*BREAK*,*ОТМЕН*")))
      (princ (strcat "\nОшибка: " msg))
    )
    (vla-EndUndoMark doc)
    (princ)
  )
  (princ "\n=== ВОРОТА: лист с узором из отгибных лепестков ===")
  (setq gw (vr:num "Ширина ворот, мм" 4000.0)
        gh (vr:num "Высота ворот, мм" 2000.0)
        th (vr:num "Толщина металла, мм" 2.0))
  (princ "\nУзоры:")
  (setq i 0)
  (foreach nm *vr-names* (setq i (1+ i)) (princ (strcat "  " (itoa i) "-" nm)))
  (setq pat (vr:int "Выберите узор [1-9]" 1 6 1 9))
  ;; размер ячейки по умолчанию для каждого узора
  (setq sz (vr:num "Размер ячейки, мм" (nth (1- pat) '(200.0 230.0 180.0 220.0 220.0 200.0 260.0 160.0 200.0))))
  ;; линии гиба (петельки) — спрашиваем всегда
  (setq br  (vr:num "Петелька (перемычка на линии гиба), мм" 2.0)
        dsh (vr:num "Прорез между петельками, мм" 10.0)
        ang (vr:num "Угол отгиба лепестков, град" 35.0))
  (setq bolt (vr:int "Соединение листов: 1-болты М8 через отбортовку, 2-сварка (без отверстий)" 1 6 1 2))
  (setq dflt (vr:int "Остальные параметры по умолчанию? 1-да, 0-нет" 1 4 0 1))
  (setq strip 14.0 brd 15.0 fl 30.0 sw 1500.0 sl 3000.0 mk3d 1 mkfr 1)
  (if (= dflt 0)
    (setq strip (vr:num "Металл между ячейками, мм" strip)
          brd   (vr:num "Ровное поле по краю панели, мм" brd)
          fl    (vr:num "Отбортовка (загиб назад) для соединения, мм" fl)
          sw    (vr:num "Лист: ширина, мм" sw)
          sl    (vr:num "Лист: длина, мм" sl)
          mk3d  (vr:int "Строить 3D-модель? 1-да, 0-нет" mk3d 4 0 1)
          mkfr  (vr:int "Рама из трубы 60x40? 1-да, 0-нет" mkfr 4 0 1))
  )
  (vla-StartUndoMark doc)
  (setq oldecho (getvar "CMDECHO"))
  (setvar "CMDECHO" 0)
  (vr:layer "REZ" 1)
  (vr:layer "LIST" 8)
  (vr:layer "TEXT" 5)
  (vr:layer "VOROTA_3D" 9)
  (vr:layer "VOROTA_RAMA" 250)
  ;; панели под размер листа (лист ставится вертикально: sw по ширине, sl по высоте)
  (setq cols (fix (+ 0.999999 (/ gw (- sw (* 2.0 fl) 10.0))))
        rows (fix (+ 0.999999 (/ gh (- sl (* 2.0 fl) 10.0))))
        pw (/ gw cols) ph (/ gh rows))
  (setq pattern (vr:pattern pat gw gh sz strip))
  (if (null pattern)
    (princ "\nУзор не построен: уменьшите размер ячейки.")
    (progn
      (setq n (* cols rows) i 0)
      ;; --- развёртки: ниже 3D-модели, каждая панель на своём листе
      (setq ri 0)
      (while (< ri rows)
        (setq ci 0)
        (while (< ci cols)
          (setq i (1+ i))
          (setq org (list (* ci (+ sw 300.0)) (- (+ (* ri (+ sl 600.0)) sl 800.0))))
          (setq cells (vr:cells pattern (* ci pw) (* ri ph) pw ph brd))
          (vr:rect (- (car org) fl 5.0) (- (cadr org) fl 5.0) sw sl "LIST")
          (vr:text (list (car org) (+ (cadr org) sl 40.0)) 60.0
                   (strcat "ЛИСТ " (itoa i) "/" (itoa n) "  " (rtos sw 2 0) "x" (rtos sl 2 0)
                           "  t=" (rtos th 2 1) "  панель " (rtos pw 2 0) "x" (rtos ph 2 0)
                           "  " (nth (1- pat) *vr-names*))
                   "TEXT")
          (vr:flat cells pw ph org br dsh fl bolt)
          (setq ci (1+ ci))
        )
        (setq ri (1+ ri))
      )
      ;; --- 3D
      (if (= mk3d 1)
        (progn
          (princ "\nСтрою 3D-модель, подождите...")
          (setq ri 0)
          (while (< ri rows)
            (setq ci 0)
            (while (< ci cols)
              (vr:3d-panel (vr:cells pattern (* ci pw) (* ri ph) pw ph brd)
                           pw ph (list (* ci pw) (* ri ph)) th (* ang (/ pi 180.0)) fl)
              (setq ci (1+ ci))
            )
            (setq ri (1+ ri))
          )
          (if (= mkfr 1) (vr:frame gw gh cols rows pw ph 60.0 40.0 (- fl)))
          (vr:text (list 0.0 (+ gh 80.0)) 80.0
                   (strcat "ВОРОТА " (rtos gw 2 0) "x" (rtos gh 2 0) ", узор "
                           (nth (1- pat) *vr-names*) ", лепестки " (rtos ang 2 0) " град")
                   "TEXT")
        )
      )
      (setq mass (* (+ (* gw gh) (* n 2.0 fl (+ pw ph))) th 7.85e-6))
      (princ (strcat "\nГотово. Панелей (листов): " (itoa n)
                     ", панель " (rtos pw 2 0) "x" (rtos ph 2 0)
                     ", лист с отбортовкой " (rtos (+ pw fl fl) 2 0) "x" (rtos (+ ph fl fl) 2 0)
                     ", масса листа ~" (rtos mass 2 0) " кг (без рамы)."))
      (princ "\nДля лазера: выгрузите слой REZ (слои LIST и TEXT отключите) — всё на REZ режется.")
      (princ "\nСмотреть 3D: команда -VIEW (-ВИД) -> ЮЗизо, стиль: ВИЗСТИЛИ -> Концептуальный.")
      (vla-ZoomExtents (vlax-get-acad-object))
    )
  )
  (setvar "CMDECHO" oldecho)
  (vla-EndUndoMark doc)
  (princ)
)

(defun c:VOROTA () (vr:main))
(defun c:ВОРОТА () (vr:main))
(princ "\nVOROTA.LSP загружен. Команда: ВОРОТА (или VOROTA).")
(princ)
